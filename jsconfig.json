{
  // Editor-only: lets VS Code type-check js/app.js using its JSDoc comments.
  // There is no build step; browsers load js/app.js as-is.
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"]
  },
  "include": ["js/**/*.js"]
}
